# 忽略构建产物
bin/
obj/
.vs/

# Launcher 发布产物（build.bat 生成，可直接双击 app/RiMCP.Launcher.exe）
/app/

# 开发报告与设计文档（本地保留，不随仓库分发）
/docs/

# 忽略本地数据与索引（包含多版本隔离目录）
# 仅匹配仓库根目录，避免误伤 src/RiMCP.Core/Models 等源码目录
# 两个数据目录的内容全部忽略，但保留占位说明 README.md
/RimWorldData/*
!/RimWorldData/README.md
/models/*
!/models/README.md
/index/
/index_*/
/.build/

# Launcher 快速预检缓存（mtime/size → 哈希），任何索引目录下都不入库
.probe-cache.json

# 忽略本地配置
appsettings.json
# Launcher 的默认配置模板需要入库，否则克隆后没有初始配置
!src/RiMCP.Launcher/appsettings.json
*.user
*.suo

# 截图等临时产物
.screenshots/
