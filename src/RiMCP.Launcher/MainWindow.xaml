<Window x:Class="RiMCP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiMCP Launcher" Height="720" Width="960"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 推荐按钮高亮：用 ControlTemplate 保证 hover/pressed 下不被系统主题覆盖 -->
        <Style x:Key="HighlightButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FDE68A"/>
            <Setter Property="BorderBrush" Value="#D97706"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FCD34D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBBF24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部环境检测条 -->
        <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="环境" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="刷新状态" Margin="12,0,0,0" Padding="10,3" Click="Refresh_Click"/>
                <ComboBox DockPanel.Dock="Right" x:Name="IndexDirCombo" Width="160" IsEditable="True"
                          Margin="8,0,0,0" VerticalAlignment="Center"
                          ToolTip="当前索引目录名（键入后回车生效）；顶部环境条会基于该目录重新检测。"
                          SelectionChanged="IndexDir_Changed" KeyDown="IndexDir_KeyDown"/>
                <TextBlock DockPanel.Dock="Right" Text="索引目录" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ItemsControl x:Name="EnvItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="2,2"
                                    Tag="{Binding}" Click="EnvItem_Click" ToolTip="{Binding Detail}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#6B7280" Margin="4,0,0,0"
                                               VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 一键诊断建议横幅 -->
        <Border x:Name="AdviceBanner" Grid.Row="1" Visibility="Collapsed" Padding="10,6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="BtnAdvice" Content="⚡ 一键执行建议"
                        Margin="12,0,0,0" Padding="12,4" Click="Advice_Click"
                        ToolTip="按建议执行对应构建"/>
                <TextBlock x:Name="AdviceText" TextWrapping="Wrap" VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- 中部：左状态表 / 右操作区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="ShardGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Margin="8" RowHeaderWidth="0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Detail}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="分片名" Binding="{Binding Shard}" Width="1.0*"/>
                    <DataGridTextColumn Header="index 版本" Binding="{Binding IndexVersion}" Width="0.6*"/>
                    <DataGridTextColumn Header="当前游戏版本" Binding="{Binding GameVersion}" Width="0.8*"/>
                    <DataGridTextColumn Header="defs+symbols" Binding="{Binding DefsSymbols}" Width="0.9*"/>
                    <DataGridTextColumn Header="vectors" Binding="{Binding Vectors}" Width="0.5*"/>
                    <DataGridTextColumn Header="lucene" Binding="{Binding Lucene}" Width="0.5*"/>
                    <DataGridTextColumn Header="graph" Binding="{Binding Graph}" Width="0.5*"/>
                    <DataGridTextColumn Header="上次构建时间" Binding="{Binding LastBuiltAt}" Width="1.3*"/>
                    <DataGridTextColumn Header="变化类型" Binding="{Binding ChangeKindText}" Width="0.9*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding ChangeReason}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="0.6*"/>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="构建" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatusNote" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="ONNX provider" VerticalAlignment="Center" Width="96"/>
                        <ComboBox x:Name="ProviderCombo" Width="180" SelectionChanged="Provider_Changed"/>
                    </StackPanel>

                    <Button x:Name="BtnFull" Content="全量重建" Margin="0,4,0,0" Padding="8,6" Click="Full_Click"/>
                    <Button x:Name="BtnIncremental" Content="增量构建" Margin="0,4,0,0" Padding="8,6" Click="Incremental_Click"/>
                    <Button x:Name="BtnGraphOnly" Content="仅图谱" Margin="0,4,0,0" Padding="8,6" Click="GraphOnly_Click"/>
                    <TextBlock x:Name="GraphOnlyNote" Foreground="#6B7280" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>

                    <Button x:Name="BtnVectors" Content="仅嵌入（降级：勾选分片 + 增量）" Margin="0,8,0,0" Padding="8,6"
                            Click="VectorsOnly_Click" ToolTip="Indexer 当前无单层触发 CLI，按增量执行；未变分片自动跳过。"/>
                    <Button x:Name="BtnLucene" Content="仅 Lucene（降级：勾选分片 + 增量）" Margin="0,4,0,0" Padding="8,6"
                            Click="LuceneOnly_Click" ToolTip="Indexer 当前无单层触发 CLI，按增量执行；未变分片自动跳过。"/>
                    <Button x:Name="BtnSelected" Content="按分片构建（勾选分片）" Margin="0,4,0,0" Padding="8,6" Click="Selected_Click"
                            ToolTip="Indexer 无按分片选择参数；勾选仅作提示，实际走增量，未变分片自动跳过。"/>
                    <TextBlock Text="注：Indexer 未提供 --only-layer / --shards 参数，单层与按分片操作已降级为增量构建。"
                               Foreground="#6B7280" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>

                    <TextBlock Text="分片勾选" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <ListBox x:Name="ShardList" Height="110">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Shard}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="BtnCancel" Content="取消构建" Margin="0,8,0,0" Padding="8,6" Click="Cancel_Click" IsEnabled="False"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="MCP 服务" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock x:Name="McpStatus" Text="已停止" Foreground="#374151" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnStartMcp" Content="启动 MCP" Padding="8,6" Width="120" Click="StartMcp_Click"/>
                        <Button x:Name="BtnStopMcp" Content="停止 MCP" Padding="8,6" Width="120" Margin="8,0,0,0" Click="StopMcp_Click"/>
                    </StackPanel>
                    <Button x:Name="BtnOpenMcpConfig" Content="打开 MCP 配置（build.json）" Margin="0,6,0,0" Padding="8,6"
                            Click="OpenMcpConfig_Click"/>
                    <Button x:Name="BtnOpenIndex" Content="打开 index 目录" Margin="0,4,0,0" Padding="8,6" Click="OpenIndex_Click"/>

                    <Separator Margin="0,12"/>
                    <Button x:Name="BtnCopyLog" Content="复制日志" Padding="8,6" Click="CopyLog_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部：进度 / 阶段 / 日志 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="BuildProgress" Grid.Row="0" Height="6" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBox x:Name="StageText" Grid.Row="1" Text="就绪" IsReadOnly="True" BorderThickness="0"
                     Background="#F9FAFB" Padding="8,2" FontWeight="SemiBold"/>
            <ListBox Grid.Row="2" x:Name="LogList" FontFamily="Consolas" FontSize="12" Margin="8,0,8,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontFamily="Consolas"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
